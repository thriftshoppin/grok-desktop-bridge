{
  "log": {
    "enabled": false,
    "script": null,
    "section": "grok-desktop-bridge",
    "log_typed_text": false,
    "fail_closed": true,
    "max_entry_chars": 700
  },
  "kill_switch": {
    "hotkeys": [
      "ctrl+alt+pause",
      "ctrl+alt+shift+k"
    ],
    "esc_second_press_s": 10,
    "esc_arm_grace_s": 0.35,
    "esc_modifier_release_grace_s": 0.30
  },
  "denylist": [
    "KeePass*",
    "Bitwarden*",
    "1Password*",
    "Dashlane*",
    "LastPass*"
  ],
  "protected_paths": [
    "%LOCALAPPDATA%\\GrokDesktopBridge",
    "%ProgramData%\\GrokDesktopBridge"
  ],
  "audio": {
    "device": null,
    "probe_ms": 150
  },
  "temp_dir": "%TEMP%\\GrokDesktopBridge",
  "retention_hours": 24,
  "screenshot": {
    "max_edge": 1568,
    "format": "jpeg",
    "jpeg_quality": 85
  },
  "ui_tree": {
    "max_nodes": 800,
    "depth": 6
  },
  "downloads": "ask",
  "control": {
    "idle_grace_s": 8,
    "border_lead_ms": 150,
    "glide_ms_min": 120,
    "glide_ms_max": 300,
    "type_ms_per_char": 8,
    "value_method_min_chars": 200,
    "yield_wait_s": 6
  },
  "overlay": {
    "color": "#FFFFFF",
    "thickness_px": 6
  },
  "blocked_combos": [
    "win+l"
  ],
  "remote": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8790,
    "grok_only": true
  },
  "feed": {
    "always_on_top": false,
    "keep_visible": true
  }
}
